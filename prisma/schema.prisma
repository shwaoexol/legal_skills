// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== ENUMS ====================

enum Format {
  ONLINE
  OFFLINE
  HYBRID
}

enum GroupStatus {
  RECRUITING // Идёт набор
  FEW_SEATS // Места заканчиваются
  FULL // Группа заполнена
  IN_PROGRESS // Обучение идёт
  FINISHED // Набор завершён
}

enum ApplicationStatus {
  NEW
  CONTACTED
  ENROLLED
  REJECTED
}

enum TeacherRole {
  TEACHER // Преподаватель
  DIRECTOR // Руководитель
  METHODIST // Методист
  STAFF // Прочие сотрудники
}

enum DocumentType {
  OFFER // Публичная оферта
  PRIVACY_POLICY // Политика персональных данных
  CONSENT // Согласие на обработку ПД
  REQUISITES // Реквизиты организации
  OTHER
}

enum AdminRole {
  SUPERADMIN
  EDITOR
}

// ==================== ОСНОВНЫЕ МОДЕЛИ ====================

model Course {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  shortDescription String?
  targetAudience   String? // "Для кого курс"
  goals            String? // Цели и результаты обучения
  program          Json // Модули программы
  academicHours    Int?
  duration         String? // "3 месяца"
  format           Format
  price            Decimal? @db.Decimal(12, 2)
  priceNote        String? // "что входит в стоимость"
  certificateInfo  String? // только по подтверждённым данным заказчика
  faq              Json?
  order            Int      @default(0)
  isPublished      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  imageUrl         String?

  groups       Group[]
  teachers     TeacherCourse[]
  reviews      Review[]
  applications Application[]

  @@index([isPublished, order])
}

model Teacher {
  id           String      @id @default(cuid())
  slug         String      @unique
  fullName     String
  role         TeacherRole @default(TEACHER)
  position     String
  photoUrl     String?
  education    String?
  experience   String?
  achievements Json? // подтверждённые сертификаты/достижения
  bio          String?
  isPublished  Boolean     @default(true)
  createdAt    DateTime    @default(now())

  courses TeacherCourse[]
  groups  Group[]
  reviews Review[]
}

// courses <-> teachers: многие-ко-многим
model TeacherCourse {
  teacherId String
  courseId  String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([teacherId, courseId])
}

model Group {
  id         String      @id @default(cuid())
  courseId   String
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId  String?
  teacher    Teacher?    @relation(fields: [teacherId], references: [id])
  startDate  DateTime
  endDate    DateTime?
  daysOfWeek String // "Пн, Ср, Пт"
  time       String // "18:00-20:00"
  format     Format
  location   String? // аудитория или ссылка на онлайн-встречу
  seatsTotal Int
  seatsTaken Int         @default(0)
  price      Decimal?    @db.Decimal(12, 2)
  status     GroupStatus @default(RECRUITING)
  createdAt  DateTime    @default(now())

  applications Application[]

  @@index([courseId, status])
}

model Application {
  id                  String            @id @default(cuid())
  name                String
  phone               String
  telegram            String?
  courseId            String?
  course              Course?           @relation(fields: [courseId], references: [id])
  groupId             String?
  group               Group?            @relation(fields: [groupId], references: [id])
  format              Format?
  preferredTime       String?
  comment             String?
  consentPersonalData Boolean           @default(false)
  utmSource           String?
  utmMedium           String?
  utmCampaign         String?
  sourceUrl           String?
  status              ApplicationStatus @default(NEW)
  createdAt           DateTime          @default(now())

  @@index([status, createdAt])
}

model Review {
  id          String   @id @default(cuid())
  authorName  String
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id])
  teacherId   String?
  teacher     Teacher? @relation(fields: [teacherId], references: [id])
  text        String
  rating      Int?
  isPublished Boolean  @default(false) // публикация только после модерации
  createdAt   DateTime @default(now())
}

model NewsPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  content     String
  imageUrl    String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

model LegalDocument {
  id          String       @id @default(cuid())
  type        DocumentType
  title       String
  fileUrl     String
  version     String
  publishedAt DateTime     @default(now())
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EDITOR)
  createdAt    DateTime  @default(now())
}
